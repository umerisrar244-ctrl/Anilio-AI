# Anilio Autonomous AI Agent Environment Variables

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Supabase Credentials (from your existing project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Provider for Anilio Brain (Qwen, OpenAI, or Gemini)
LLM_PROVIDER=qwen
QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
GEMINI_API_KEY=

# Existing Anilio AI Application Integration URL
ANILIO_EXISTING_API_URL=https://api.animorra.ai/v1
ANILIO_EXISTING_API_TOKEN=your-existing-token

# Video GPU Worker Adapter (Wan 2.2 TI2V-5B)
WAN22_WORKER_URL=http://localhost:8001
WAN22_DEVICE=cuda:0
WAN22_MODEL_PATH=Wan-AI/Wan2.1-T2V-1.4B
WAN22_OFFLOAD_CPU=true
MAX_PARALLEL_SCENES=2

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
OUTPUT_STORAGE_BUCKET=videos
